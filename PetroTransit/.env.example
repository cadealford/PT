# Local development only.
# Copy this file to `.env` in the same folder and fill in the values you want to use locally.

# Local Postgres connection for `dotnet run`
# This matches the Docker Compose Postgres container when it is running locally.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=petrotransit;Username=petro;Password=your-local-docker-db-password

# JWT signing key for the API
AppSettings__Token=replace-with-a-long-random-secret

# Frontend/API localhost URLs
Frontend__BaseUrl=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5270

# Optional SMTP config for password reset emails
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=

# Optional dev seed user
Seed__Email=
Seed__Username=
Seed__Password=

# Docker Compose local DB defaults
POSTGRES_DB=petrotransit
POSTGRES_USER=petro
POSTGRES_PASSWORD=your-local-docker-db-password
